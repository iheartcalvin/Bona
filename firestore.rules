rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // System Config
    match /system/config {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Sponsors: Public read (authenticated), Admin write
    match /sponsors/{sponsorId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Daily Word of the Day: Auth read/create
    match /daily_wod/{date} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Allow first user to create the daily verse
    }

    // Admin Check Helper
    function isAdmin() {
      // Current Admin UID: dRpi4MxEuZg9yuaX6lScmlDPNVf1
      return request.auth != null && (
        request.auth.uid == 'dRpi4MxEuZg9yuaX6lScmlDPNVf1'
      );
    }

    // Users: Admin can read/write all. Users can only read/write their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      
      // Friend Requests explicit override to allow others to send requests
      match /requests/{requestId} {
         allow create: if request.auth != null;
         // Allow read if owner OR if the user is the one who sent the request
         allow read: if request.auth != null && (request.auth.uid == userId || resource.data.fromUid == request.auth.uid);
         allow delete: if request.auth != null && (request.auth.uid == userId || resource.data.fromUid == request.auth.uid);
         allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }

      // Followers: Anyone can follow (if followerId == Me), 
      // OR Receiver can add Requestor (if Request exists)
      match /followers/{followerId} {
         allow read: if request.auth != null;
         allow create, update: if request.auth != null && (
            request.auth.uid == followerId || 
            exists(/databases/$(database)/documents/users/$(userId)/requests/$(followerId))
         );
         allow delete: if request.auth != null && (request.auth.uid == followerId || request.auth.uid == userId);
      }
      
      // Sub-collection: Notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId); // Or controlled by functions
      }
      
      // Sub-collection: Rewards (Publicly visible badges)
      match /rewards/{rewardId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }
      
      // Following: Owner can manage their following list, 
      // OR Target can add Requestor (if Request exists)
      match /following/{followingId} {
         allow read: if request.auth != null;
         allow write: if request.auth != null && (
            request.auth.uid == userId ||
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/requests/$(userId))
         );
      }

      // Subcollections general rule (Owner only) - Fallback
      match /{allSubcollections=**} {
         allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }
    
    // Charity Events: Public/Auth read, Admin only write
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Channels (Spaces): Auth users can read/write
    match /channels/{channelId} {
      allow read, write: if request.auth != null;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
